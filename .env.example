# ─────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────

# Clés publiques (protégées par Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Clé service_role — SECRÈTE, jamais préfixée NEXT_PUBLIC_.
# Elle contourne toutes les politiques RLS et n'est utilisée que par les routes
# API de paiement, qui doivent écrire dans profiles et payments sans session.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# ─────────────────────────────────────────────────────────────────────────
# URL publique du site (redirections de paiement)
# ─────────────────────────────────────────────────────────────────────────
# En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://chinoislingo.com

# ─────────────────────────────────────────────────────────────────────────
# Moneroo — Mobile Money & carte, grille FCFA
# https://app.moneroo.io/developers/api-keys
# ─────────────────────────────────────────────────────────────────────────
# Le mode test ou production est déterminé par la clé elle-même : il n'existe
# pas d'URL d'API distincte pour le bac à sable.
MONEROO_SECRET_KEY=votre-cle-secrete-moneroo

# Secret HMAC du webhook — https://app.moneroo.io/developers/webhooks
# Y déclarer l'URL : https://votre-domaine/api/webhooks/moneroo
MONEROO_WEBHOOK_SECRET=votre-secret-webhook-moneroo

# ─────────────────────────────────────────────────────────────────────────
# Stripe — carte bancaire, grille EUR, abonnement récurrent
# https://dashboard.stripe.com/apikeys
# ─────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx

# Secret du point de terminaison webhook (un secret par endpoint).
# Y déclarer l'URL : https://votre-domaine/api/webhooks/stripe
# Événements à cocher : checkout.session.completed, invoice.paid,
# invoice.payment_failed, customer.subscription.updated,
# customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Identifiants de tarifs récurrents en EUR, à créer dans le tableau de bord :
#   mensuel    → 13,99 € tous les 1 mois
#   semestriel → 59,99 € tous les 6 mois
#   annuel     → 99,99 € tous les 12 mois
# Attention : les objets Stripe sont cloisonnés entre test et production.
# Un price_... créé en mode test n'existe pas avec une clé live.
STRIPE_PRICE_MENSUEL=price_xxx
STRIPE_PRICE_SEMESTRIEL=price_xxx
STRIPE_PRICE_ANNUEL=price_xxx
