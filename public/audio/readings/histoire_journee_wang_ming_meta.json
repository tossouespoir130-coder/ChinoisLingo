    {
      "sentenceId": "h_wm_1",
      "hanzi": "王明是学生。他有一个好朋友，叫李月。李月也是学生。",
      "startMs": 0,
      "endMs": 5759,
      "durationMs": 5759
    },
    {
      "sentenceId": "h_wm_2",
      "hanzi": "今天天气很好。不冷，也不热。",
      "startMs": 5759,
      "endMs": 9253,
      "durationMs": 3181
    },
    {
      "sentenceId": "h_wm_3",
      "hanzi": "上午，王明去学校。他在学校学习汉语。他看见李月。李月很高兴。",
      "startMs": 9253,
      "endMs": 16498,
      "durationMs": 6885
    },
    {
      "sentenceId": "h_wm_4",
      "hanzi": "中午，王明和李月去饭店。王明吃米饭，喝茶。李月吃米饭，喝水。",
      "startMs": 16498,
      "endMs": 24010,
      "durationMs": 7001
    },
    {
      "sentenceId": "h_wm_5",
      "hanzi": "下午，他们回家。王明在家看电视。李月在家看书。",
      "startMs": 24010,
      "endMs": 29861,
      "durationMs": 5479
    },
    {
      "sentenceId": "h_wm_6",
      "hanzi": "今天，王明很高兴。李月也很高兴。",
      "startMs": 29861,
      "endMs": 33774,
      "durationMs": 3913
    }
  ]
