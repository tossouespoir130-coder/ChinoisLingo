  "sentences": [
    {
      "sentenceId": "htf_1",
      "hanzi": "弟弟找不到他的手机。",
      "startMs": 0,
      "endMs": 2240,
      "durationMs": 2240,
      "audioUrl": "/audio/readings/histoire_telephone_frigo_htf_1.mp3"
    },
    {
      "sentenceId": "htf_2",
      "hanzi": "他问妈妈：“妈妈，你看见我的手机了吗？”",
      "startMs": 2240,
      "endMs": 8720,
      "durationMs": 5880,
      "audioUrl": "/audio/readings/histoire_telephone_frigo_htf_2.mp3"
    },
    {
      "sentenceId": "htf_3",
      "hanzi": "妈妈说：“没有。你打一下电话吧。”",
      "startMs": 8720,
      "endMs": 14080,
      "durationMs": 4760,
      "audioUrl": "/audio/readings/histoire_telephone_frigo_htf_3.mp3"
    },
    {
      "sentenceId": "htf_4",
      "hanzi": "弟弟说：“我的手机在哪儿？我怎么打？”",
      "startMs": 14080,
      "endMs": 19840,
      "durationMs": 5200,
      "audioUrl": "/audio/readings/histoire_telephone_frigo_htf_4.mp3"
    },
    {
      "sentenceId": "htf_5",
      "hanzi": "妈妈笑了：“用我的手机打。”",
      "startMs": 19840,
      "endMs": 24480,
      "durationMs": 3960,
      "audioUrl": "/audio/readings/histoire_telephone_frigo_htf_5.mp3"
    },
    {
      "sentenceId": "htf_6",
      "hanzi": "妈妈打电话。他们听见冰箱里有声音。",
      "startMs": 24480,
      "endMs": 30080,
      "durationMs": 4400,
      "audioUrl": "/audio/readings/histoire_telephone_frigo_htf_6.mp3"
    },
    {
      "sentenceId": "htf_7",
      "hanzi": "弟弟打开冰箱，手机在里面！",
      "startMs": 30080,
      "endMs": 34720,
      "durationMs": 3440,
      "audioUrl": "/audio/readings/histoire_telephone_frigo_htf_7.mp3"
    },
    {
      "sentenceId": "htf_8",
      "hanzi": "妈妈问：“手机为什么在冰箱里？”",
      "startMs": 34720,
      "endMs": 39920,
      "durationMs": 4600,
      "audioUrl": "/audio/readings/histoire_telephone_frigo_htf_8.mp3"
    },
    {
      "sentenceId": "htf_9",
      "hanzi": "弟弟说：“因为手机太热了，我把它放进冰箱里，让它冷一点。”",
      "startMs": 39920,
      "endMs": 48720,
      "durationMs": 8120,
      "audioUrl": "/audio/readings/histoire_telephone_frigo_htf_9.mp3"
    },
    {
      "sentenceId": "htf_10",
      "hanzi": "妈妈说：“手机不是人，不怕热。”",
      "startMs": 48720,
      "endMs": 54240,
      "durationMs": 4920,
      "audioUrl": "/audio/readings/histoire_telephone_frigo_htf_10.mp3"
    },
    {
      "sentenceId": "htf_11",
      "hanzi": "弟弟说：“但是它现在很冷。”",
      "startMs": 54240,
      "endMs": 59600,
      "durationMs": 4760,
      "audioUrl": "/audio/readings/histoire_telephone_frigo_htf_11.mp3"
    },
    {
      "sentenceId": "htf_12",
      "hanzi": "妈妈笑着说：“那你给它拿一件衣服吧。”",
      "startMs": 59600,
      "endMs": 64240,
      "durationMs": 4640,
