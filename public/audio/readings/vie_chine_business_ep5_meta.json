      "endMs": 29760,
      "durationMs": 1480,
      "audioUrl": "/audio/readings/vie_chine_business_ep5_vc_b5_11.mp3"
    },
    {
      "sentenceId": "vc_b5_12",
      "hanzi": "好，谢谢。",
