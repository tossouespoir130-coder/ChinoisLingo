      "endMs": 21360,
      "durationMs": 960,
      "audioUrl": "/audio/readings/vie_chine_business_ep5_vc_b5_7.mp3"
    },
    {
      "sentenceId": "vc_b5_8",
      "hanzi": "还要什么？",
      "startMs": 21360,
      "endMs": 23280,
      "durationMs": 880,
      "audioUrl": "/audio/readings/vie_chine_business_ep5_vc_b5_8.mp3"
    },
    {
      "sentenceId": "vc_b5_9",
      "hanzi": "还要一瓶咖啡。",
      "startMs": 23280,
      "endMs": 25680,
      "durationMs": 1920,
      "audioUrl": "/audio/readings/vie_chine_business_ep5_vc_b5_9.mp3"
    },
    {
      "sentenceId": "vc_b5_10",
      "hanzi": "好。多少钱？",
      "startMs": 25680,
      "endMs": 28280,
      "durationMs": 1440,
      "audioUrl": "/audio/readings/vie_chine_business_ep5_vc_b5_10.mp3"
    },
    {
