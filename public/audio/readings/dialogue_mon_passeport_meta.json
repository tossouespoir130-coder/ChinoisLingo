  "sentences": [
    {
      "sentenceId": "dmp_1",
      "speaker": "小明",
      "hanzi": "小红，我的护照在哪儿？",
      "startMs": 0,
      "endMs": 1920,
      "durationMs": 1920,
      "audioUrl": "/audio/readings/dialogue_mon_passeport_dmp_1.mp3"
    },
    {
      "sentenceId": "dmp_2",
      "speaker": "小红",
      "hanzi": "你的护照不是在桌子上吗？",
      "startMs": 2270,
      "endMs": 4430,
      "durationMs": 2160,
      "audioUrl": "/audio/readings/dialogue_mon_passeport_dmp_2.mp3"
    },
    {
      "sentenceId": "dmp_3",
      "speaker": "小明",
      "hanzi": "桌子上没有。我找了，没有。",
      "startMs": 4780,
      "endMs": 8140,
      "durationMs": 3360,
      "audioUrl": "/audio/readings/dialogue_mon_passeport_dmp_3.mp3"
    },
    {
      "sentenceId": "dmp_4",
      "speaker": "小红",
      "hanzi": "你再看看，是不是在书下面？",
      "startMs": 8490,
      "endMs": 11050,
      "durationMs": 2560,
      "audioUrl": "/audio/readings/dialogue_mon_passeport_dmp_4.mp3"
    },
    {
      "sentenceId": "dmp_5",
      "speaker": "小明",
      "hanzi": "书下面也没有。怎么办？我们要迟到了！",
      "startMs": 11400,
      "endMs": 15080,
      "durationMs": 3680,
      "audioUrl": "/audio/readings/dialogue_mon_passeport_dmp_5.mp3"
    },
    {
      "sentenceId": "dmp_6",
      "speaker": "小红",
      "hanzi": "别急。你昨天用护照了吗？",
      "startMs": 15430,
      "endMs": 18230,
      "durationMs": 2800,
      "audioUrl": "/audio/readings/dialogue_mon_passeport_dmp_6.mp3"
    },
    {
      "sentenceId": "dmp_7",
      "speaker": "小明",
      "hanzi": "用了。我买了飞机票。",
      "startMs": 18580,
      "endMs": 20500,
      "durationMs": 1920,
      "audioUrl": "/audio/readings/dialogue_mon_passeport_dmp_7.mp3"
    },
    {
      "sentenceId": "dmp_8",
      "speaker": "小红",
      "hanzi": "那你想想，买了票以后，你放在哪儿了？",
      "startMs": 20850,
      "endMs": 23970,
      "durationMs": 3120,
      "audioUrl": "/audio/readings/dialogue_mon_passeport_dmp_8.mp3"
    },
    {
      "sentenceId": "dmp_9",
      "speaker": "小明",
      "hanzi": "嗯……我放在包里了。",
      "startMs": 24320,
      "endMs": 26160,
      "durationMs": 1840,
      "audioUrl": "/audio/readings/dialogue_mon_passeport_dmp_9.mp3"
    },
    {
      "sentenceId": "dmp_10",
      "speaker": "小红",
      "hanzi": "哪个包？黑色的？蓝色的？",
      "startMs": 26510,
      "endMs": 29390,
      "durationMs": 2880,
      "audioUrl": "/audio/readings/dialogue_mon_passeport_dmp_10.mp3"
    },
    {
      "sentenceId": "dmp_11",
      "speaker": "小明",
      "hanzi": "蓝色的包。但是包里没有。",
      "startMs": 29740,
      "endMs": 33180,
      "durationMs": 3440,
      "audioUrl": "/audio/readings/dialogue_mon_passeport_dmp_11.mp3"
    },
    {
      "sentenceId": "dmp_12",
      "speaker": "小红",
      "hanzi": "你去看看你的衣服里有没有。",
      "startMs": 33530,
      "endMs": 35450,
      "durationMs": 1920,
      "audioUrl": "/audio/readings/dialogue_mon_passeport_dmp_12.mp3"
    },
    {
      "sentenceId": "dmp_13",
      "speaker": "小明",
      "hanzi": "好，我去看看。……找到了！在我的衣服里！",
      "startMs": 35800,
      "endMs": 39800,
      "durationMs": 4000,
      "audioUrl": "/audio/readings/dialogue_mon_passeport_dmp_13.mp3"
    },
    {
      "sentenceId": "dmp_14",
      "speaker": "小红",
      "hanzi": "太好了！我们走吧，飞机要飞了。",
      "startMs": 40150,
      "endMs": 43510,
      "durationMs": 3360,
      "audioUrl": "/audio/readings/dialogue_mon_passeport_dmp_14.mp3"
    },
    {
      "sentenceId": "dmp_15",
      "speaker": "小明",
      "hanzi": "好的，快走！",
      "startMs": 43860,
      "endMs": 46340,
      "durationMs": 2480,
      "audioUrl": "/audio/readings/dialogue_mon_passeport_dmp_15.mp3"
    }
  ]
}